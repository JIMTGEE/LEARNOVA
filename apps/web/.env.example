# Copy to .env.local and fill in from Supabase: Project Settings > API.
# These two values are meant to be public (they ship in the browser bundle).
# Row Level Security in the database is what protects the data.
# NEVER put a service_role key, an SMS key or an AI key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
